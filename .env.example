# Configuração local opcional: copie este arquivo para .env.
DB_PASSWORD=wallet
DB_PORT=5433
API_PORT=8081
AUTHORIZATION_URL=https://util.devi.tools/api/v2/authorize
NOTIFICATION_URL=https://util.devi.tools/api/v1/notify
NOTIFICATION_MAX_ATTEMPTS=5
# Obrigatório fora do Compose de demonstração. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=15m
# Assistente de IA (POST /assistant/chat). Padrão: Ollama local, sem custo.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
ASSISTANT_TIMEOUT=120s
# Só para AI_PROVIDER=anthropic (Claude, cobrado por token).
ANTHROPIC_API_KEY=
